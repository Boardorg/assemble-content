# Names only. Real values live in the hub's .env.contentful, never in this repo.
# Run scripts from this folder with: node --env-file=../../.env.contentful <script>.mjs

# Space ID (Settings -> General settings)
CONTENTFUL_SPACE_ID=
# Content Management API token (Settings -> CMA tokens). An org owner must authorize new tokens.
CONTENTFUL_MANAGEMENT_TOKEN=
# The environment the scripts write to. Every script refuses `master`.
CONTENTFUL_ENVIRONMENT=field-report

# Used by setup-wp-webhook.mjs
AFR_WEBHOOK_SECRET=
WP_BETA_WEBHOOK_URL=https://assemblebeta.wpenginepowered.com/wp-json/assemble/v1/contentful
